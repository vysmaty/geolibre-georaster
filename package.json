{
  "name": "geolibre-georaster",
  "version": "0.2.2",
  "description": "Export visible maps and raster layers as georeferenced PNG or JPEG in EPSG:5514",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/types/react.d.ts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/types/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./style.css": "./dist/geolibre-georaster.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "pnpm run build:lib && pnpm run build:geolibre",
    "build:lib": "tsc -p tsconfig.json && vite build",
    "build:geolibre": "vite build --config vite.geolibre.config.ts",
    "package:geolibre": "pnpm run build:geolibre && node scripts/verify-geolibre-bundle.mjs && node scripts/package-geolibre-plugin.mjs",
    "install:geolibre": "pnpm run build:geolibre && node scripts/install-geolibre-plugin.mjs",
    "serve:geolibre": "node scripts/serve-geolibre-plugin.mjs",
    "test": "vitest --run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "prepublishOnly": "pnpm run build:lib"
  },
  "keywords": [
    "geolibre",
    "maplibre",
    "maplibre-gl",
    "map",
    "plugin",
    "georeferencing",
    "epsg-5514",
    "s-jtsk",
    "typescript"
  ],
  "author": "vysmaty",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vysmaty/geolibre-georaster.git"
  },
  "peerDependencies": {
    "maplibre-gl": ">=3.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.9.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^4.1.8",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "maplibre-gl": "^5.24.0",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "geotiff": "^3.0.5",
    "proj4": "^2.22.0"
  }
}
